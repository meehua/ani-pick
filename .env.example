# AniPick 基础配置示例
# 用法：复制为 .env 并按需修改。真实环境变量优先级高于 .env。
# 注意：.env 含密钥，不要提交；.env.example 可以入库。
#
# 环境变量只承担两类职责：
#   1. 引导期必需 —— 服务地址、数据库、管理员账号、凭据加密密钥；
#   2. 基础设施规格 —— 连接池与 HTTP 超时（与部署形态绑定，改了要重启）。
# 一切运行期业务配置（数据源启用/顺序/评分权重/每源请求间隔/凭据/抓取参数/
# 抓取种子与调度/出站代理/DoH/ECH/真实 IP 识别）都在管理后台调整：
# 数据源与抓取在「抓取设置」，真实 IP 在「设置 → 限流与安全」，改完即生效。
# 数据库里的凭据用 ANIPICK_SECRET 加密（secretbox），绝不进环境变量之外的日志。

# ---------- 服务（引导期专用） ----------
ANIPICK_ADDR=:8787
# PostgreSQL 连接串（裸机运行使用；Docker Compose 会覆盖为 postgres 服务）
ANIPICK_DATABASE_URL=postgres://ani_pick:ani_pick@127.0.0.1:5432/ani_pick?sslmode=disable

# ---------- 管理员（引导期专用） ----------
# 首次启动时写入数据库（bcrypt），之后请在管理后台修改
ANIPICK_ADMIN_PASSWORD=change-me
# 用于加密数据库中的凭据（站长凭据/各来源 API Key）；不配置则明文保存（仍是服务器数据库）
ANIPICK_SECRET=change-me-to-a-long-random-string

# ---------- 连接池规格（基础设施；默认按 1GB 内存机校准，换机器按内存调整） ----------
ANIPICK_DB_MAX_CONNS=12
ANIPICK_DB_MIN_CONNS=2
# 连接最长存活时间（Go duration 格式：90s / 2m / 1h）；防反代侧断连后拿到死连接
ANIPICK_DB_CONN_LIFETIME=1h
# 连接空闲回收时间；0 = 永不按空闲回收（交给 MaxConnLifetime 兜底）
ANIPICK_DB_CONN_IDLE_TIME=0
# 空闲连接健康检查周期
ANIPICK_DB_HEALTH_CHECK_PERIOD=30s

# ---------- HTTP 超时（基础设施；防慢客户端/慢上游占住连接） ----------
# 读请求头超时（Slowloris 防护）
ANIPICK_HTTP_READ_HEADER_TIMEOUT=10s
# 读整个请求（含 body）超时
ANIPICK_HTTP_READ_TIMEOUT=30s
# 写响应超时（列表页 gzip 压缩在大结果集时需要余量）
ANIPICK_HTTP_WRITE_TIMEOUT=120s
# 空闲连接保活时长
ANIPICK_HTTP_IDLE_TIMEOUT=90s

# ---------- 其他（引导期专用） ----------
ANIPICK_DEBUG=false

# ---------- Docker Compose ----------
# 仅 docker compose 使用；不要包含 @ : / ? # 等 URL 特殊字符
POSTGRES_PASSWORD=ani_pick
ANIPICK_PORT=8787
ANIPICK_IMAGE=ghcr.io/meehua/ani-pick
ANIPICK_IMAGE_TAG=latest
# Go 堆内存上限（1GB 小机防 OOM）：默认 192MiB，可按机器调整
GOMEMLIMIT=192MiB
# PostgreSQL 调优（默认按 1GB 内存机校准）：换大机器时同步提高，
# 例：4GB 机可设 PG_MAX_CONNECTIONS=100、PG_SHARED_BUFFERS=1GB、PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MAX_CONNECTIONS=40
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=256MB
