# AniPick 基础配置示例
# 用法：复制为 .env 并按需修改。真实环境变量优先级高于 .env。
# 注意：.env 含密钥，不要提交；.env.example 可以入库。

# ---------- 服务 ----------
ANIPICK_ADDR=:8787
# PostgreSQL 连接串（本地默认库名 / 用户名 / 密码均为 ani_pick）
ANIPICK_DATABASE_URL=postgres://ani_pick:ani_pick@127.0.0.1:5432/ani_pick?sslmode=disable

# ---------- 管理员 ----------
# 首次启动时写入数据库（bcrypt），之后请在管理后台修改
ANIPICK_ADMIN_PASSWORD=change-me
# 用于加密数据库中的 Bangumi 凭据；不配置则明文保存（仍是服务器数据库）
ANIPICK_SECRET=change-me-to-a-long-random-string

# ---------- 站长 Bangumi 账号（后台抓取用，可选） ----------
# 配置后可以抓取需要登录的条目；不配置也能抓公开条目
ANIPICK_BGM_TOKEN=
ANIPICK_BGM_COOKIE=
ANIPICK_BGM_UA=AniPick/1.0 (+https://github.com/bangumi; local indexer)

# ---------- 抓取默认值 ----------
# 仅作为首次启动的种子值；启动后以管理后台设置为准
ANIPICK_CRAWL_TYPES=1,2,3,4,6
ANIPICK_CRAWL_PAGE_SIZE=100
ANIPICK_CRAWL_DELAY_MS=350
ANIPICK_BGM_TIMEOUT_SEC=40
ANIPICK_REFRESH_TTL_DAYS=30
ANIPICK_REFRESH_BATCH=300
ANIPICK_INCREMENTAL_PAGES=10
ANIPICK_INCREMENTAL_INTERVAL_MIN=360
ANIPICK_AUTO_INCREMENTAL=true
ANIPICK_AUTO_REFRESH=true
ANIPICK_PRUNE_ON_FULL=true

# ---------- 出站网络（仅服务端抓取使用） ----------
# 用 IP 形式的 DoH 入口做解析，避免系统 DNS 污染；ECH 在上游发布 ECHConfig 后自动生效
ANIPICK_DOH=true
ANIPICK_ECH=true
ANIPICK_DOH_ENDPOINTS=https://dns.alidns.com/resolve,https://1.1.1.1/dns-query

# 仅服务端抓取使用：配置后抓取流量走该代理（用户请求永不经过服务端）
# 例：http://127.0.0.1:7890（本机代理）或 socks5://127.0.0.1:1080
ANIPICK_EGRESS_PROXY=

# ---------- 其他 ----------
ANIPICK_DEBUG=false
